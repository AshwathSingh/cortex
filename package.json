{
  "name": "cortex",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev_watchdog.sh",
    "dev:watch": "bash scripts/dev_watchdog.sh",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "setup": "node scripts/dev_environment.mjs setup",
    "db:setup": "node scripts/dev_environment.mjs databases",
    "dev:check": "node scripts/dev_environment.mjs check",
    "test:environment": "node --test scripts/tests/*.test.mjs"
  },
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2"
}
