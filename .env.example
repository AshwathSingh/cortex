# Postgres
POSTGRES_USER=cortex
POSTGRES_PASSWORD=YOUR_PASS
POSTGRES_DB=cortex
# If this host port changes, update the port in DATABASE_URL as well.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cortex:YOUR_PASS@localhost:5432/cortex
SESSION_TTL_DAYS=30
SECURE_COOKIES=false

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_PASS

# GitHub OAuth (US-1) -- see backend/README.md "GitHub sign-in"
GITHUB_CLIENT_ID=YOUR_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Must match the OAuth app's "Authorization callback URL" exactly.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
# Encrypts stored GitHub tokens; validated at startup. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Comma-separated old keys that may still decrypt, only while rotating
# (see backend/README.md "Rotating the token key").
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
# Requests per minute per client IP on each /api/auth/github/* endpoint.
OAUTH_RATE_LIMIT_PER_MINUTE=20

# Optional: raises the GitHub API rate limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# --- Slack (US-08). Only needed to connect a Slack workspace as a source. ---
# Slack app credentials, from https://api.slack.com/apps -> Basic Information.
# The app's OAuth redirect URL must equal SLACK_OAUTH_REDIRECT_URI exactly.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/sources/slack/callback
# Bot scopes requested at install. channels:history is what allows reading
# messages; the *:read pair lists the channels to choose from.
SLACK_OAUTH_SCOPE=channels:read,channels:history,groups:read,groups:history,users:read

# --- Discord (US-08). Only needed to connect a Discord server as a source. ---
# Discord reads history with a BOT token, not a user token, so the install flow
# adds the bot to a server and DISCORD_BOT_TOKEN does the reading. From
# https://discord.com/developers/applications -> your app -> Bot / OAuth2.
# Enable "Message Content Intent" on the Bot page or message text comes back empty.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/sources/discord/callback
# View Channels (1024) + Read Message History (65536).
DISCORD_BOT_PERMISSIONS=66560
